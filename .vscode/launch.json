{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Runserver",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "127.0.0.1:8001"],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "config.settings"
            }
        },
        {
            "name": "Consumer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["consume_events"],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "config.settings"
            }
        }
    ]
}
